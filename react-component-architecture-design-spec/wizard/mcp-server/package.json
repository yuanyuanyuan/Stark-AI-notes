{
  "name": "react-arch-wizard-mcp",
  "version": "1.0.0",
  "description": "React架构向导 MCP服务器 - 通过智能对话完成专业架构设计",
  "main": "dist/index.js",
  "bin": {
    "react-arch-wizard-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "react",
    "architecture",
    "wizard",
    "claude",
    "ai-assistant"
  ],
  "author": "React Arch Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "zod": "^3.22.0",
    "handlebars": "^4.7.8",
    "fs-extra": "^11.2.0",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.7",
    "@types/lodash": "^4.14.202",
    "@types/fs-extra": "^11.0.4",
    "@types/handlebars": "^4.1.0",
    "typescript": "^5.3.0",
    "tsx": "^4.6.0",
    "vitest": "^1.0.4",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/react-arch-wizard.git"
  },
  "files": [
    "dist/**/*",
    "data/**/*",
    "README.md"
  ]
}