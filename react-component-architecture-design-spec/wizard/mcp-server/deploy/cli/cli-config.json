{
  "name": "react-arch-wizard-cli",
  "version": "1.0.0",
  "description": "React架构向导命令行工具",
  "bin": {
    "react-arch-wizard": "./dist/cli.js"
  },
  "config": {
    "server": {
      "command": "node",
      "args": ["./dist/server.js"],
      "cwd": "./react-component-architecture-design-spec/wizard/mcp-server"
    },
    "modes": {
      "interactive": {
        "description": "交互式对话模式",
        "default": true
      },
      "batch": {
        "description": "批处理模式（使用配置文件）",
        "configFile": "wizard-config.json"
      },
      "automation": {
        "description": "自动化模式（CI/CD集成）",
        "silent": true,
        "outputFormat": "json"
      }
    },
    "output": {
      "formats": ["json", "yaml", "markdown"],
      "default": "json",
      "verbose": false
    }
  },
  "commands": {
    "start": {
      "description": "启动架构向导",
      "usage": "react-arch-wizard start <project-name>",
      "options": {
        "--type": "项目类型 (ecommerce|saas|dashboard|blog|other)",
        "--team-size": "团队规模 (数字)",
        "--output": "输出目录",
        "--config": "配置文件路径",
        "--interactive": "交互式模式",
        "--batch": "批处理模式",
        "--verbose": "详细输出"
      }
    },
    "generate": {
      "description": "根据会话生成架构",
      "usage": "react-arch-wizard generate <session-id>",
      "options": {
        "--output": "输出目录",
        "--format": "输出格式 (json|yaml|markdown)",
        "--include-tests": "包含测试文件",
        "--include-examples": "包含示例代码"
      }
    },
    "export": {
      "description": "导出完整项目",
      "usage": "react-arch-wizard export <session-id> <output-path>",
      "options": {
        "--include-tests": "包含测试文件",
        "--include-examples": "包含示例代码",
        "--template": "使用的模板集合"
      }
    },
    "validate": {
      "description": "验证架构规范合规性",
      "usage": "react-arch-wizard validate <session-id>",
      "options": {
        "--spec": "规范文件路径",
        "--output": "验证报告输出路径"
      }
    },
    "list": {
      "description": "列出所有会话",
      "usage": "react-arch-wizard list",
      "options": {
        "--format": "输出格式",
        "--filter": "过滤条件"
      }
    },
    "clean": {
      "description": "清理过期会话和缓存",
      "usage": "react-arch-wizard clean",
      "options": {
        "--days": "保留天数",
        "--force": "强制清理"
      }
    }
  },
  "examples": [
    {
      "description": "交互式创建电商项目",
      "command": "react-arch-wizard start my-ecommerce --interactive"
    },
    {
      "description": "批量创建SaaS应用",
      "command": "react-arch-wizard start my-saas --type saas --team-size 10 --batch"
    },
    {
      "description": "导出项目到指定目录",
      "command": "react-arch-wizard export session-123 ./output --include-tests"
    },
    {
      "description": "验证架构合规性",
      "command": "react-arch-wizard validate session-123 --spec ./custom-spec.yaml"
    }
  ]
}