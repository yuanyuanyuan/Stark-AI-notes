{
  "name": "React Architecture Wizard",
  "description": "React架构设计向导，通过对话生成项目架构",
  "version": "1.0.0",
  "provider": "mcp",
  "config": {
    "server": {
      "command": "node",
      "args": ["./dist/server.js"],
      "cwd": "./react-component-architecture-design-spec/wizard/mcp-server"
    },
    "features": {
      "conversation": true,
      "codeGeneration": false,
      "fileOperations": false
    },
    "ui": {
      "title": "React架构向导",
      "description": "让AI帮你设计React项目架构",
      "icon": "🏗️",
      "color": "#61DAFB"
    }
  },
  "prompts": {
    "welcome": "你好！我是React架构向导。我可以通过对话帮你设计完整的React项目架构。\n\n请告诉我你想创建什么类型的项目？",
    "examples": [
      "我想创建一个电商网站",
      "帮我设计一个任务管理应用",
      "我需要一个SaaS应用的架构"
    ]
  }
}