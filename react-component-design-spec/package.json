{
  "name": "react-component-design-spec",
  "version": "1.0.0",
  "description": "React组件设计规范 - 完整的开发指南和最佳实践",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:performance": "node scripts/performance/performance-test.js",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:all": "node scripts/test/test-all.js",
    "test:debug": "jest --runInBand --no-cache",
    
    "generate:component": "node tools/component-generator.js",
    "generate:test-data": "node tools/test-data-generator.js",
    "generate:report": "node scripts/coverage/coverage-report.js",
    
    "lint": "eslint src tests --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src tests --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write src tests tools",
    "format:check": "prettier --check src tests tools",
    
    "validate": "npm run type-check && npm run lint && npm run test",
    "validate:all": "npm run type-check && npm run lint && npm run test:all",
    
    "docs:build": "npm run docs:prepare && npm run docs:generate",
    "docs:serve": "npm run docs:build && npm run docs:dev",
    "docs:prepare": "node scripts/docs/prepare-docs.js",
    "docs:generate": "node scripts/docs/generate-docs.js",
    "docs:dev": "cd docs && npm run dev",
    
    "clean": "rm -rf node_modules .next coverage test-results playwright-report",
    "clean:cache": "rm -rf .jest-cache .next node_modules/.cache",
    "clean:coverage": "rm -rf coverage",
    "clean:results": "rm -rf test-results playwright-report",
    
    "setup": "npm install && npm run setup:tests",
    "setup:tests": "npm run playwright:install",
    "playwright:install": "npx playwright install --with-deps",
    
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    
    "quick-test": "./scripts/test/test.sh",
    "quick-test:windows": "scripts\\test\\test.bat",
    "quick-test:coverage": "./scripts/test/test.sh -c",
    "quick-test:e2e": "./scripts/test/test.sh -t e2e",
    "quick-test:all": "./scripts/test/test.sh -t all",
    
    "debug:quick": "node scripts/debug/diagnose.js --quick",
    "debug:full": "node scripts/debug/diagnose.js",
    "debug:report": "node scripts/debug/diagnose.js --generate-report",
    "debug:start": "./scripts/debug/debug.sh",
    "debug:chrome": "./scripts/debug/debug.sh -t chrome",
    "debug:vscode": "./scripts/debug/debug.sh -t vscode",
    
    "deploy:check": "npm run validate:all && npm run build",
    "deploy:preview": "npm run build && npm run docs:build"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "testing",
    "typescript",
    "best-practices",
    "development-guide"
  ],
  "author": "Claude",
  "license": "MIT",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "next": "14.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "tailwindcss": "^3.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "clsx": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "lucide-react": "^0.292.0",
    "@radix-ui/react-slot": "^1.0.2",
    "zustand": "^4.4.0",
    "@tanstack/react-query": "^5.0.0",
    "react-hook-form": "^7.47.0",
    "@hookform/resolvers": "^3.3.0",
    "zod": "^3.22.0",
    "axios": "^1.6.0",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@testing-library/react": "^13.4.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@testing-library/dom": "^9.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-config": "^29.7.0",
    "@jest/types": "^29.5.0",
    "babel-jest": "^29.7.0",
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "jest-transform-stub": "^2.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest-environment-node": "^29.7.0",
    
    "@playwright/test": "^1.39.0",
    "playwright": "^1.39.0",
    "@playwright/experimental-ct-react": "^1.39.0",
    
    "cypress": "^13.5.0",
    "@cypress/vue": "^5.0.0",
    "@cypress/webpack-preprocessor": "^6.0.0",
    
    "eslint": "^8.52.0",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-testing-library": "^6.1.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-jsx-a11y": "^6.7.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.0.0",
    
    "prettier": "^3.0.0",
    "@prettier/plugin-xml": "^3.2.0",
    
    "typescript": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    
    "@faker-js/faker": "^8.3.0",
    "mock-xml-http-request": "^2.0.0",
    "msw": "^2.0.0",
    "whatwg-fetch": "^3.6.0",
    
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0",
    
    "lighthouse": "^11.4.0",
    "lighthouse-ci": "^0.12.0",
    
    "nodemon": "^3.0.0",
    "rimraf": "^5.0.0",
    "mkdirp": "^3.0.0",
    "cross-env": "^7.0.0",
    
    "husky": "^8.0.0",
    "lint-staged": "^15.0.0",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    
    "jest-junit": "^16.0.0",
    "jest-html-reporter": "^3.10.0",
    "jest-sonar-reporter": "^2.0.0",
    
    "codecov": "^3.8.0",
    "@codecov/codecov-action": "^3.1.0",
    
    "dotenv": "^16.3.0",
    "dotenv-cli": "^7.3.0",
    
    "ts-node": "^10.9.0",
    "@tsconfig/node18": "^18.2.0",
    "@tsconfig/react": "^18.2.0",
    
    "concurrently": "^8.2.0",
    "wait-on": "^7.2.0",
    "kill-port": "^2.0.0",
    
    "fs-extra": "^11.1.0",
    "glob": "^10.3.0",
    "yargs": "^17.7.0",
    "chalk": "^5.3.0",
    "ora": "^7.0.0",
    "inquirer": "^9.2.0",
    "commander": "^11.1.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup/jest.setup.js"
    ],
    "moduleNameMapping": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@/test-utils/(.*)$": "<rootDir>/test-utils/$1",
      "^@/tests/(.*)$": "<rootDir>/tests/$1"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react-jsx"
          }
        }
      ]
    },
    "testMatch": [
      "**/__tests__/**/*.(ts|tsx|js|jsx)",
      "**/*.(test|spec).(ts|tsx|js|jsx)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/index.ts",
      "!src/**/*.stories.{ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "coverageReporters": [
      "text",
      "lcov",
      "html",
      "json"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-results",
          "outputName": "junit.xml"
        }
      ]
    ]
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "@typescript-eslint/recommended",
      "plugin:react/recommended",
      "plugin:react-hooks/recommended",
      "plugin:testing-library/react",
      "plugin:jest/recommended",
      "plugin:prettier/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "plugins": [
      "react",
      "react-hooks",
      "testing-library",
      "jest",
      "@typescript-eslint"
    ],
    "env": {
      "browser": true,
      "es2022": true,
      "jest": true
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    },
    "rules": {
      "react/react-in-jsx-scope": "off",
      "@typescript-eslint/no-unused-vars": "error",
      "@typescript-eslint/no-explicit-any": "warn",
      "testing-library/no-debug": "warn",
      "testing-library/no-render-in-setup": "error",
      "jest/no-disabled-tests": "warn",
      "jest/no-focused-tests": "error",
      "jest/no-identical-title": "error",
      "jest/prefer-to-have-length": "warn",
      "jest/valid-expect": "error"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "jsxSingleQuote": false,
    "bracketSameLine": false,
    "quoteProps": "as-needed"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}